with "anet_common";

library project Anet is

   for Source_Dirs use
     ("src",
      "src/" & Anet_Common.OS);
   for Library_Name use "anet";

   case Anet_Common.Version
   is
      when "" =>
         for Library_Kind use "static";
      when others =>
         for Library_Kind use "dynamic";
         --  When linking the library itself.
         for Leading_Library_Options use Anet_Common.Ldflags;
         for Library_Version use "libanet.so." & Anet_Common.Version;
   end case;

   for Object_Dir use "obj/" & Anet_Common.OS & "/lib/" & project'Library_Kind;
   for Library_Dir use Anet'Object_Dir & "/lib";

   package Compiler is
      for Switches ("ada") use Anet_Common.Compiler_Switches
        & ("-gnatwale") & Anet_Common.Adaflags;
   end Compiler;

end Anet;
