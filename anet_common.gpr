abstract project Anet_Common is

   for Source_Dirs use ();

   --  Set Version to "" for a static library.
   Version := external ("VERSION");

   type OS_Type is ("linux", "bsd");
   OS : OS_Type := external ("OS");

   Target := external ("TARGET_ARCH", "x86_64");

   --  User settings should take precedence over any default.
   Adaflags := External_As_List ("ADAFLAGS", " ");
   Ldflags  := External_As_List ("LDFLAGS", " ");

   Obj_Dir := "obj/" & OS;

   Additional_Switches := ();
   case Target is
      when "x86_64" => Additional_Switches := ("-fcf-protection");
      when "aarch64" | "arm" =>
         Additional_Switches := ("-mbranch-protection=standard");
      when others => null;
   end case;

   Compiler_Switches :=
     ("-gnatygAdISuxo",
      "-gnatVa",
      "-gnatf",
      "-fstack-protector-strong",
      "-fstack-clash-protection",
      "-gnato",
      "-g") & Additional_Switches;

   package Binder is
      for Switches ("Ada") use ("-E");
   end Binder;

   package Linker is
      for Switches ("Ada") use Ldflags;
   end Linker;

end Anet_Common;
